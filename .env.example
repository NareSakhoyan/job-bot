# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=jobbot
POSTGRES_DB=jobbot
POSTGRES_PORT=5432

# --- Application ---
# Host-side connection string (app runs on host, Postgres in Docker).
# Runtime queries. Local Postgres from docker-compose:
DATABASE_URL=postgresql://jobbot:jobbot@localhost:5432/jobbot?schema=public

# Against a pooled host (Supabase, Neon, any PgBouncer in transaction mode)
# use the pooled connection here and the direct one below. Both flags matter:
# pgbouncer=true stops Prisma issuing prepared statements the pooler cannot
# honour, and connection_limit=1 stops a serverless deployment opening a new
# connection on every invocation.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
#
# DIRECT_URL is only used by migrations, which a pooler cannot run: DDL and
# advisory locks need a real connection. Leave it unset for a plain local
# Postgres — prisma.config.ts then points it at DATABASE_URL, because Prisma
# treats a declared but missing variable as a validation error rather than
# falling back on its own.
# DIRECT_URL=

# debug | info | warn | error
LOG_LEVEL=info

# Optional override for the repo-root data/ directory.
# DATA_DIR=/absolute/path/to/data

# --- LLM provider (Phase 2) ---
# anthropic | none.  Without a key the system still runs: deterministic
# scoring works and the reasoning layer reports itself as unavailable.
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# --- Cost controls for matching (Phase 5) ---
# Matching runs over every discovered job and only produces explanation, so a
# smaller model is often the right trade. Unset, it uses LLM_MODEL.
# LLM_MATCH_MODEL=claude-haiku-4-5
# LLM_MATCH_EFFORT=low

# --- Dashboard access ---
# Unset means no authentication, which is fine on localhost. Set it and the
# dashboard requires Basic auth — do that before exposing it on a network.

# Dashboard authentication (Clerk). Both come from the Clerk dashboard under
# API keys. The publishable key is safe in the browser; the secret key is not.
#
# Every route requires a signed-in user, so these must be set wherever the
# dashboard is deployed — without them the app fails to start rather than
# serving unauthenticated, which is the intended failure.
#
# Restrict who can create an account in the Clerk dashboard itself; the
# sign-up route exists because Clerk links to it, not because anyone should
# be able to use it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

