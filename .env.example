# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=jobbot
POSTGRES_DB=jobbot
POSTGRES_PORT=5432

# --- Application ---
# Host-side connection string (app runs on host, Postgres in Docker).
DATABASE_URL=postgresql://jobbot:jobbot@localhost:5432/jobbot?schema=public

# debug | info | warn | error
LOG_LEVEL=info

# Optional override for the repo-root data/ directory.
# DATA_DIR=/absolute/path/to/data

# --- LLM provider (Phase 2) ---
# anthropic | none.  Without a key the system still runs: deterministic
# scoring works and the reasoning layer reports itself as unavailable.
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# --- Cost controls for matching (Phase 5) ---
# Matching runs over every discovered job and only produces explanation, so a
# smaller model is often the right trade. Unset, it uses LLM_MODEL.
# LLM_MATCH_MODEL=claude-haiku-4-5
# LLM_MATCH_EFFORT=low

# --- Dashboard access ---
# Unset means no authentication, which is fine on localhost. Set it and the
# dashboard requires Basic auth — do that before exposing it on a network.
# DASHBOARD_PASSWORD=
